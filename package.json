{
  "name": "clyptara-protocol",
  "version": "0.1.0",
  "description": "An independent open protocol for AI assistants, actions, and data",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./stdio": { "types": "./dist/src/transports/stdio.d.ts", "import": "./dist/src/transports/stdio.js" },
    "./https": { "types": "./dist/src/transports/https.d.ts", "import": "./dist/src/transports/https.js" },
    "./webrtc": { "types": "./dist/src/transports/webrtc.d.ts", "import": "./dist/src/transports/webrtc.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "example": "tsx examples/hello.ts",
    "test:bridge": "tsx test/bridge/start.ts"
  },
  "dependencies": { "ajv": "^8.17.1" },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": { "werift": "^0.25.1" },
  "peerDependenciesMeta": { "werift": { "optional": true } }
}
